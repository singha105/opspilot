# OpsPilot configuration. Copy to .env and adjust; .env is gitignored.
# Every variable is optional; the values below are the defaults.

# Logging: DEBUG | INFO | WARNING | ERROR, and JSON (true) or console (false) output.
OPSPILOT_LOG_LEVEL=INFO
OPSPILOT_LOG_JSON=true

# Local LLM served by Ollama.
OPSPILOT_LLM_PROVIDER=ollama
OPSPILOT_LLM_MODEL=qwen3:4b
OPSPILOT_OLLAMA_BASE_URL=http://localhost:11434
OPSPILOT_LLM_SEED=42
OPSPILOT_LLM_NUM_CTX=8192
OPSPILOT_LLM_KEEP_ALIVE=5m
# json (constrained JSON tool choice, default) or native tool calling. See ADR-0011.
OPSPILOT_AGENT_TOOL_STRATEGY=json

# Weaviate (started by `make infra-up`). Host port 8090, not 8080, to avoid clashing
# with other local web servers.
OPSPILOT_WEAVIATE_URL=http://localhost:8090
# Weaviate gRPC is published on 50052 because Multipass's daemon owns 50051.
OPSPILOT_WEAVIATE_GRPC_PORT=50052

# Knowledge base, local data (gitignored) and RAG models.
OPSPILOT_KNOWLEDGE_DIR=knowledge
OPSPILOT_DATA_DIR=data
OPSPILOT_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
OPSPILOT_RERANKER_MODEL=ms-marco-MiniLM-L-12-v2
OPSPILOT_DEFAULT_STORE=weaviate
# Retrieval defaults from ADR-0004 (hybrid, alpha 0.5, no rerank, 6 chunks).
OPSPILOT_RETRIEVAL_MODE=hybrid
OPSPILOT_RETRIEVAL_ALPHA=0.5
OPSPILOT_RETRIEVAL_RERANK=false
OPSPILOT_RETRIEVAL_K=6
# The agent's own retrieval step reranks by default (ADR-0012); search above does not.
OPSPILOT_AGENT_RERANK=true

# Optional Pinecone (free Starter tier). Leave unset to skip Pinecone entirely.
# PINECONE_API_KEY=
OPSPILOT_PINECONE_CLOUD=aws
OPSPILOT_PINECONE_REGION=us-east-1

# Kubernetes. The admin context is used by fault injection only, never by the agent.
OPSPILOT_ADMIN_CONTEXT=k3d-opspilot
OPSPILOT_DEMO_NAMESPACE=shop
# Agent kubeconfigs are generated here by scripts/make_kubeconfig.sh (gitignored).
OPSPILOT_SECRETS_DIR=.secrets
OPSPILOT_SCENARIOS_DIR=faults/scenarios
OPSPILOT_DEMO_BASE_DIR=demo/k8s/base

# Optional tracing: Phoenix + OpenInference (uv sync --group tracing;
# docker compose -f infra/docker-compose.yml --profile tracing up -d phoenix).
OPSPILOT_TRACING=false
OPSPILOT_PHOENIX_ENDPOINT=http://localhost:6006/v1/traces

# MCP servers. The k8s and actions servers refuse namespaces outside this list (JSON list).
OPSPILOT_ALLOWED_NAMESPACES=["shop"]
OPSPILOT_RUNS_DIR=runs
OPSPILOT_FIXTURES_DIR=evals/fixtures
# HMAC key for approval tokens. Put it in .secrets/.env, never here:
#   echo "OPSPILOT_APPROVAL_SECRET=$(openssl rand -hex 32)" >> .secrets/.env
# OPSPILOT_APPROVAL_SECRET=
