# OpsPilot configuration. Copy to .env and adjust; .env is gitignored.
# Every variable is optional; the values below are the defaults.

# Logging: DEBUG | INFO | WARNING | ERROR, and JSON (true) or console (false) output.
OPSPILOT_LOG_LEVEL=INFO
OPSPILOT_LOG_JSON=true

# Local LLM served by Ollama.
OPSPILOT_LLM_MODEL=qwen3:4b
OPSPILOT_OLLAMA_BASE_URL=http://localhost:11434

# Weaviate (started by `make infra-up`).
OPSPILOT_WEAVIATE_URL=http://localhost:8080

# Kubernetes. The admin context is used by fault injection only, never by the agent.
OPSPILOT_ADMIN_CONTEXT=k3d-opspilot
OPSPILOT_DEMO_NAMESPACE=shop
# Agent kubeconfigs are generated here by scripts/make_kubeconfig.sh (gitignored).
OPSPILOT_SECRETS_DIR=.secrets
OPSPILOT_SCENARIOS_DIR=faults/scenarios
OPSPILOT_DEMO_BASE_DIR=demo/k8s/base
